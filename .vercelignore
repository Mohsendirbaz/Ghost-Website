# Vercel ignore file
# Exclude heavy directories and files from deployment

# Development dependencies
node_modules/
.pnp/
.pnp.js

# Testing
coverage/

# Build artifacts (included via public/ and build/)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Large local folders not needed for deployment
Documents/

# Python cache (from TeaSpace nested project)
__pycache__/
*.py[cod]
*$py.class
