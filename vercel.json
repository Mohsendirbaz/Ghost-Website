{
  "buildCommand": "DISABLE_ESLINT_PLUGIN=true npm run build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=3600, stale-while-revalidate=60" }
      ]
    }
  ]
}
